{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "certificados-bautismo",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bautismos",
      "database_id": "aaa09101-4d09-4c2c-af33-2df3b5863e13",
      "migrations_dir": "migrations"
    }
  ]
}
