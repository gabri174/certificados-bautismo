# API proxy: mantén el frontend en ServerByt y reenvía /api/* al backend Cloudflare Worker.
# Requiere Apache con mod_rewrite + mod_proxy + mod_proxy_http habilitados por el hosting.
# Si el hosting no permite proxy desde .htaccess, usa el endpoint PHP de api/ como fallback.

RewriteEngine On

# Nunca reescribir el endpoint API a index.html.
RewriteRule ^api(?:/(.*))?$ https://0949daf4-bautismos.ensupresenciacrtv.workers.dev/api/$1 [P,L,NE]

# SPA/static fallback (si aplica al frontend).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
