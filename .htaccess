# Frontend y API en el mismo dominio.
# /api/* se procesa en ServerByt y se reenvía internamente al Worker desde PHP.
# No hay redirección al dominio workers.dev y no hace falta cambiar DNS.

RewriteEngine On

# API: nunca dejar que /api/* caiga en el fallback de la SPA.
RewriteRule ^api(?:/.*)?$ api/index.php [L,QSA]

# Frontend SPA/static fallback.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
